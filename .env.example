# Copy to .env and fill in real values.

# Required
# The secret configured on the GitHub App's webhook (one webhook covers
# every repo the App is installed on).
WEBHOOK_SECRET=change-me

# GitHub App credentials. Create the App under Settings → Developer
# settings → GitHub Apps, generate a private key (downloads a .pem), then:
#   base64 < your-app.private-key.pem | tr -d '\n'
# and paste the result below. Barney mints a short-lived, repo-scoped
# installation token per event from these — there is no long-lived PAT.
APP_ID=change-me
APP_PRIVATE_KEY=change-me

# Optional
PORT=8080
WORKSPACE_ROOT=/var/lib/barney/workspaces
EVENT_TIMEOUT=30m

# ── Agent credentials ──────────────────────────────────────────
# Barney is stateless: opencode never needs `auth login`. Provider keys
# are injected here, inherited by the opencode process on every run, and
# survive container upgrades. Uncomment the one your models use:
# ANTHROPIC_API_KEY=sk-ant-change-me
# OPENAI_API_KEY=sk-change-me
# Any other env var in this container is inherited by opencode too —
# including its own settings (see https://opencode.ai/docs).
