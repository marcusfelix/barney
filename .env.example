# Copy to .env and fill in real values.

# Required
WEBHOOK_SECRET=change-me
GITHUB_TOKEN=ghp_change-me

# Optional
PORT=8080
WORKSPACE_ROOT=/var/lib/barney/workspaces
EVENT_TIMEOUT=30m

# ── Agent credentials ──────────────────────────────────────────
# Barney is stateless: opencode never needs `auth login`. Provider keys
# are injected here, inherited by the opencode process on every run, and
# survive container upgrades. Uncomment the one your models use:
# ANTHROPIC_API_KEY=sk-ant-change-me
# OPENAI_API_KEY=sk-change-me
# Any other env var in this container is inherited by opencode too —
# including its own settings (see https://opencode.ai/docs).
