# Copy to .env and fill in real values.

# Required
WEBHOOK_SECRET=change-me
GITHUB_TOKEN=ghp_change-me

# Optional
PORT=8080
WORKSPACE_ROOT=/var/lib/barney/workspaces
EVENT_TIMEOUT=30m

# Agent credentials are inherited by the opencode CLI from the environment.
# Provide whichever your opencode config expects, e.g.:
# ANTHROPIC_API_KEY=sk-ant-change-me
# OPENAI_API_KEY=sk-change-me
